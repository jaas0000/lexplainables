# Publieke variabelen (leken van uit de browser). Alleen te gebruiken in Client Components.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only: API-token dat de BFF injecteert bij server→server-fetches naar de api.
# Nooit als NEXT_PUBLIC_* exposeren — dan lekt hij naar de bundel (zie CLAUDE.md).
API_BASE_URL=http://localhost:8000
API_TOKEN=lokaal-ontwikkeltoken

# Auth.js (v5) — JWT-signing key voor de sessie-cookie. Minimaal 32 tekens.
# Genereer met: `openssl rand -base64 32` of `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
AUTH_SECRET=lokaal-development-secret-minstens-32-tekens-lang!

# NEXTAUTH_URL is optioneel; Auth.js valt in development terug op localhost.
# In productie zet je 'm expliciet: NEXTAUTH_URL=https://jouw-domein.example
# NEXTAUTH_URL=

# Rate-limit-knoppen voor /v1/auth/verify (0 = uit).
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_S=60

# OpenTelemetry (leeg = no-op — alleen JSON-logging).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=lexplainables-frontend

# LLM-throttle en logging.
# LLM_MAX_CONCURRENCY=4
# LOG_LEVEL=info
# LOG_FORMAT=json
